# Port TCP (WebSocket) interne du serveur de jeu NanoForge — voir docker-compose.yml
# pour le port publié côté hôte (les deux valent 4446 en dev, pas de remap).
NANOFORGE_SERVER_LISTENING_TCP_PORT=4446
# Adresse/port utilisés par le CLIENT (servi par ce même service) pour se connecter
# au serveur — vus depuis le NAVIGATEUR du joueur, donc localhost + le port PUBLIÉ,
# jamais une adresse interne au réseau Docker.
NANOFORGE_CLIENT_SERVER_TCP_PORT=4446
# IP littérale, pas "localhost" : le validateur de @nanoforge-dev/config (isURL avec
# require_tld par défaut) rejette un nom d'hôte sans TLD — seul isIP() passe alors.
NANOFORGE_CLIENT_SERVER_ADDRESS=127.0.0.1
NANOFORGE_CLIENT_WSS=false
