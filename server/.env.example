DATABASE_URL=postgresql://sp_user:sp_password@localhost:5432/points_sourires
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Optionnel : URL du webhook Discord pour l'alerte de lancement de mini-jeu
# (voir admin_config.discord_notifications_enabled pour l'activer/désactiver).
DISCORD_WEBHOOK_URL=
# Optionnel : ID (pas le nom) du rôle Discord à taguer dans l'alerte.
# Active le mode développeur Discord, clic droit sur le rôle > Copier l'ID du rôle.
DISCORD_ALERT_ROLE_ID=
