# Copie ce fichier en `.env.production` sur le VPS (jamais commité) et remplis
# de vraies valeurs. Utilisé par docker-compose.prod.yml uniquement.

DOMAIN=sp.example.com

POSTGRES_USER=sp_user
POSTGRES_PASSWORD=change_me_to_a_long_random_value
POSTGRES_DB=points_sourires

# Génère avec: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_value
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_value

# Optionnel : alerte Discord au lancement d'un mini-jeu (voir
# admin_config.discord_notifications_enabled pour l'activer/désactiver).
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_ROLE_ID=

# Requis pour activer l'abonnement Ko-fi (CLAUDE.md section 8) : le
# "Verification Token" affiché sur https://ko-fi.com/manage/webhooks. Vide =
# le webhook /api/subscriptions/kofi-webhook refuse tout (503).
KOFI_VERIFICATION_TOKEN=
# URL de la page Ko-fi du MSP (ex: https://ko-fi.com/tonpseudo), affichée sur
# le profil des joueurs. Baked au build (Vite), donc un changement nécessite
# de rebuild le conteneur caddy (voir docker-compose.prod.yml).
VITE_KOFI_URL=
